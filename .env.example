# ─────────────────────────────────────────────
# Piano Lead Finder — Environment Variables
# Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────

# Google Maps Platform API key
# Required for: Places Search, Place Details
# Get one at: https://console.cloud.google.com
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# (Future) Microsoft Dynamics CRM
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
DYNAMICS_TENANT_ID=
DYNAMICS_ORG_URL=

# Storage path (defaults to ./output/leads.json)
LEADS_DB_PATH=output/leads.json

# Scraper behavior
# Delay between requests in seconds (be polite to servers)
REQUEST_DELAY_SECONDS=1.5
# Max retries on failed requests
MAX_RETRIES=3
# Request timeout in seconds
REQUEST_TIMEOUT=10
